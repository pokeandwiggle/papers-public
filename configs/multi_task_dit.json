{
  "model": "multi_task_dit",
  "notes": "LeRobot MultiTask DiT with flow matching and a separate vision encoder per camera. Padded targets are excluded from the loss.",
  "train_all_episodes": true,
  "args": [
    "--policy.type=multi_task_dit",
    "--policy.objective=flow_matching",
    "--policy.do_mask_loss_for_padding=true",
    "--policy.timestep_sampling_strategy=uniform",
    "--policy.sigma_min=0",
    "--policy.num_integration_steps=10",
    "--policy.integration_method=euler",
    "--policy.n_obs_steps=1",
    "--policy.horizon=32",
    "--policy.n_action_steps=32",
    "--policy.hidden_dim=512",
    "--policy.num_layers=6",
    "--policy.num_heads=16",
    "--policy.use_rope=false",
    "--policy.use_positional_encoding=true",
    "--policy.use_separate_rgb_encoder_per_camera=true",
    "--policy.vision_encoder_name=openai/clip-vit-base-patch16",
    "--policy.vision_encoder_lr_multiplier=0.1",
    "--policy.text_encoder_name=openai/clip-vit-base-patch16",
    "--policy.image_crop_shape=[224,224]",
    "--policy.optimizer_lr=2e-5",
    "--policy.optimizer_weight_decay=1e-6",
    "--policy.scheduler_name=cosine",
    "--policy.scheduler_warmup_steps=500",
    "--policy.use_amp=true",
    "--dataset.image_transforms.enable=true",
    "--dataset.use_imagenet_stats=false",
    "--batch_size=256",
    "--num_workers=32",
    "--save_freq=5000"
  ],
  "epochs": 25,
  "min_steps": 20000
}
