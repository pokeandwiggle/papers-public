{
  "model": "paw_pi05",
  "train_all_episodes": true,
  "notes": "PI05 control for the FACT LN study: identical to pi05, but actions are openpi DeltaActions (EE xyz + rotation columns minus the anchor state; closed fractions absolute) with statistics fitted on those relative chunk targets. Native Beta(1.5, 1) timestep sampling.",
  "args": [
    "--batch_size=64",
    "--num_workers=32",
    "--policy.type=paw_pi05",
    "--policy.chunk_size=32",
    "--policy.compile_model=true",
    "--policy.compile_mode=default",
    "--policy.device=cuda",
    "--policy.dtype=bfloat16",
    "--policy.freeze_vision_encoder=true",
    "--policy.gradient_checkpointing=true",
    "--policy.n_action_steps=32",
    "--policy.optimizer_lr=5e-5",
    "--policy.optimizer_weight_decay=1e-10",
    "--policy.scheduler_warmup_steps=500",
    "--policy.base_repo=lerobot/pi05_base",
    "--policy.base_revision=b211f3d44c36b6acfcf7ae94a64e8e96f75a64ba",
    "--policy.use_amp=false",
    "--save_freq=2000",
    "--policy.use_relative_actions=true",
    "--policy.relative_exclude_joints=[\"closed_fraction\"]",
    "--policy.paw_time_sampling=beta"
  ],
  "epochs": 3,
  "min_steps": 10000
}
