{
  "model": "diffusion_ema",
  "epochs": 25,
  "min_steps": 200000,
  "train_all_episodes": true,
  "notes": "ManiFlow-study control: LeRobot Diffusion Policy (U-Net, DDIM 16 steps) with the original Diffusion Policy EMA weights served, 64-step horizon with 32 emitted actions, and the ManiFlow paper's shared 2D augmentation. Shares backbone, data, horizon and budget with the maniflow preset. See paw_baseline/maniflow/CHECKLIST.md.",
  "args": [
    "--batch_size=64",
    "--dataset.image_transforms.enable=true",
    "--dataset.image_transforms.max_num_transforms=2",
    "--dataset.image_transforms.tfs={\"color_jitter\":{\"weight\":1.0,\"type\":\"ColorJitter\",\"kwargs\":{\"brightness\":[0.7,1.3],\"contrast\":[0.6,1.4],\"saturation\":[0.5,1.5],\"hue\":[-0.08,0.08]}},\"rotation\":{\"weight\":1.0,\"type\":\"RandomRotation\",\"kwargs\":{\"degrees\":[-5.0,5.0]}}}",
    "--num_workers=32",
    "--policy.compile_mode=default",
    "--policy.compile_model=true",
    "--policy.crop_shape=[243,243]",
    "--policy.drop_n_last_frames=0",
    "--policy.horizon=64",
    "--policy.n_action_steps=32",
    "--policy.n_obs_steps=1",
    "--policy.noise_scheduler_type=DDIM",
    "--policy.num_inference_steps=16",
    "--policy.num_train_timesteps=100",
    "--policy.type=diffusion_ema",
    "--policy.ema_power=0.75",
    "--policy.ema_max_value=0.9999",
    "--policy.use_ema_for_inference=true",
    "--save_freq=5000"
  ]
}
