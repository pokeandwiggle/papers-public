{
  "model": "maniflow",
  "epochs": 25,
  "min_steps": 200000,
  "train_all_episodes": true,
  "notes": "2D ManiFlow: DiT-X with multi-token conditioning (per-camera ResNet-18 feature-map tokens + state token, official TransformerObsEncoder path), consistency flow training, EMA weights served, 2 Euler inference steps, 64-step horizon with 32 emitted actions. Data, backbone, augmentation, horizon, batch and budget match diffusion_ema. See paw_baseline/maniflow/CHECKLIST.md.",
  "args": [
    "--batch_size=64",
    "--dataset.image_transforms.enable=true",
    "--dataset.image_transforms.max_num_transforms=2",
    "--dataset.image_transforms.tfs={\"color_jitter\":{\"weight\":1.0,\"type\":\"ColorJitter\",\"kwargs\":{\"brightness\":[0.7,1.3],\"contrast\":[0.6,1.4],\"saturation\":[0.5,1.5],\"hue\":[-0.08,0.08]}},\"rotation\":{\"weight\":1.0,\"type\":\"RandomRotation\",\"kwargs\":{\"degrees\":[-5.0,5.0]}}}",
    "--num_workers=32",
    "--policy.crop_shape=[243,243]",
    "--policy.drop_n_last_frames=0",
    "--policy.horizon=64",
    "--policy.n_action_steps=32",
    "--policy.n_obs_steps=1",
    "--policy.type=maniflow",
    "--policy.n_layer=12",
    "--policy.n_head=8",
    "--policy.n_emb=768",
    "--policy.flow_batch_ratio=0.75",
    "--policy.consistency_batch_ratio=0.25",
    "--policy.sample_t_mode_flow=beta",
    "--policy.sample_t_mode_consistency=discrete",
    "--policy.denoise_timesteps=10",
    "--policy.sample_target_t_mode=relative",
    "--policy.num_inference_steps=2",
    "--policy.ema_power=0.75",
    "--policy.ema_max_value=0.9999",
    "--policy.use_ema_for_inference=true",
    "--save_freq=5000"
  ]
}
